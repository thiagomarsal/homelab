# kube-prometheus-stack Helm values — rendered by Ansible
# Tuned for K3s homelab — no Alertmanager, Longhorn storage, Traefik ingress

alertmanager:
  enabled: true
  alertmanagerSpec:
    replicas: 1
    retention: 120h
    # emptyDir on purpose — NOT Longhorn. Longhorn degradation is one of the
    # things Alertmanager must report, so its state must not depend on Longhorn.
    # Cost: silences and dedup state are lost on restart (one repeat email).
    storage: {}
    resources:
      requests:
        cpu: 10m
        memory: 48Mi
      limits:
        memory: 128Mi
  config:
    global:
      resolve_timeout: 5m
      smtp_smarthost: 'smtp.gmail.com:587'
      smtp_from: '{{ alert_smtp_user }}'
      smtp_auth_username: '{{ alert_smtp_user }}'
      # Google displays app passwords in four groups of four for readability, and it is
      # easy to vault the value with those spaces still in it. SMTP AUTH does not accept
      # them — Gmail answers "535 5.7.8 Username and Password not accepted" — so strip
      # whitespace here rather than depending on how the value was pasted into vault.
      smtp_auth_password: '{{ alert_smtp_password | replace(" ", "") }}'
      smtp_require_tls: true

    route:
      receiver: email-warning
      group_by: ['alertname', 'pve_host']
      group_wait: 45s
      group_interval: 5m
      repeat_interval: 24h
      routes:
        # Watchdog is the upstream always-firing heartbeat. Nothing consumes it
        # yet (no external dead-man's switch by decision), so drop it.
        - matchers: ['alertname="Watchdog"']
          receiver: 'null'
        # Chart-shipped meta-alert carrying severity=none — its own annotation
        # says it should be routed to a null receiver, or it mails on every
        # info-level alert via the default receiver fallback.
        - matchers: ['alertname="InfoInhibitor"']
          receiver: 'null'
        - matchers: ['severity="info"']
          receiver: 'null'
        - matchers: ['severity="critical"']
          receiver: email-critical
          group_wait: 30s
          repeat_interval: 2h
        - matchers: ['severity="warning"']
          receiver: email-warning

    inhibit_rules:
      # A partition reads as one event, not eight host failures.
      - source_matchers: ['alertname="PVEClusterNotQuorate"']
        target_matchers: ['alertname="PVEHostDown"']

      # The k8s cascade is muted via `node`, which the guest alert carries from
      # pve_guest_info.name. No static IP-to-host map is needed anywhere.
      # node!="" guards against an empty pve_guest_info.name: Alertmanager
      # treats an absent label as "", which would otherwise match — and mute —
      # every alert that has no `node` label at all.
      - source_matchers: ['alertname="PVEGuestDownUnexpectedly"', 'node!=""']
        target_matchers: ['alertname!="PVEGuestDownUnexpectedly"']
        equal: ['node']

      # Host-level noise about a host already known to be down. PVEGuestDownUnexpectedly
      # is deliberately NOT a target: you want to know which guests died, and that
      # alert is the inhibitor for the k8s cascade rule above.
      - source_matchers: ['alertname="PVEHostDown"']
        target_matchers: ['alertname=~"PVEStorage.*|PVEHostMemoryPressure|PVEExporterTargetDown"']
        equal: ['pve_host']

      # While a node is down, mute pod-level churn cluster-wide. Coarse on
      # purpose: KSM pod alerts have no reliable node label. Trade-off is that an
      # unrelated pod problem can hide during a node outage — the runbook says to
      # re-check pods after recovery.
      - source_matchers: ['alertname=~"KubeNodeNotReady|KubeNodeUnreachable"']
        target_matchers: ['alertname=~"KubePod.*|KubeDeployment.*|KubeStatefulSet.*|KubeDaemonSet.*"']

      # >0.95 always trips >0.85 on the same storage; keyed on the storage id so
      # only the matching warning is muted, not warnings on other storages.
      - source_matchers: ['alertname="PVEStorageCritical"']
        target_matchers: ['alertname="PVEStorageFillingUp"']
        equal: ['id']

    receivers:
      - name: 'null'

      - name: email-critical
        email_configs:
          - to: '{{ alert_email_to }}'
            send_resolved: true
            headers:
              subject: {% raw %}'[CRIT] {{ .CommonLabels.alertname }} {{ .CommonLabels.pve_host }}{{ .CommonLabels.node }}'{% endraw %}

            html: {% raw %}'{{ range .Alerts }}<b>{{ .Labels.alertname }}</b> ({{ .Labels.severity }})<br>{{ .Annotations.summary }}<br>{{ .Annotations.description }}<br>started {{ .StartsAt }}<br><br>{{ end }}'{% endraw %}


      - name: email-warning
        email_configs:
          - to: '{{ alert_email_to }}'
            send_resolved: true
            headers:
              subject: {% raw %}'[warn] {{ .CommonLabels.alertname }} {{ .CommonLabels.pve_host }}{{ .CommonLabels.node }}'{% endraw %}

            html: {% raw %}'{{ range .Alerts }}<b>{{ .Labels.alertname }}</b><br>{{ .Annotations.summary }}<br>{{ .Annotations.description }}<br>started {{ .StartsAt }}<br><br>{{ end }}'{% endraw %}

# k3s trips these permanently — a standing wall of firing alerts trains you to
# ignore email.
#
# Validated 2026-08-17 against live behaviour: with these six disabled, the only
# alerts firing on a healthy fleet were real findings, not group noise — a Traefik
# scrape target that never existed, a Prometheus volume capped at ~85% by its own
# retentionSize, stale failed Jobs, and workloads in namespaces that had been
# deleted. Each was fixed at the source rather than by disabling another group,
# which is the outcome this list is meant to produce.
defaultRules:
  create: true
  rules:
    kubeApiserverAvailability: false
    kubeApiserverBurnrate: false
    kubeApiserverHistogram: false
    kubeApiserverSlos: false
    kubernetesResources: false
    kubernetesSystem: false

nodeExporter:
  enabled: true

# node-exporter is a subchart; its ServiceMonitor values live under this
# top-level key. Values placed under `nodeExporter:` are silently ignored, and
# the CRD requires camelCase here (snake_case is for raw scrape configs only).
prometheus-node-exporter:
  prometheus:
    monitor:
      relabelings:
        # node-exporter series carry only instance=IP:9100 by default, so
        # nothing could correlate them with a k3s node name. Inhibition and the
        # runbook both key on `node`.
        - sourceLabels: [__meta_kubernetes_pod_node_name]
          targetLabel: node

prometheus:
  prometheusSpec:
    # Prometheus alone uses ~1.75Gi. Keep it off master-3, which is the tightest
    # host and also fronts the pfSense VM.
    nodeSelector:
      kubernetes.io/hostname: k3s-worker-2
    retention: 15d
    retentionSize: "7GB"
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: longhorn
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              # Raised 8Gi -> 16Gi on 2026-08-17: at 8Gi with retentionSize 7GB the
              # volume sat at ~85% permanently, so KubePersistentVolumeFillingUp fired
              # forever. The live PVC was expanded in place (Longhorn online expansion);
              # this keeps the template matching reality, since helm cannot shrink a PVC.
              storage: 16Gi
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    additionalScrapeConfigs:
      - job_name: pve
        metrics_path: /pve
        params:
          module: [default]
        static_configs:
{% for h in groups['pve'] | sort %}
          - targets: ["{{ hostvars[h].ansible_host }}"]
            labels:
              pve_host: "{{ h }}"
{% endfor %}
        relabel_configs:
          - source_labels: [__address__]
            target_label: __param_target
          - source_labels: [__param_target]
            target_label: instance
          - target_label: __address__
            replacement: prometheus-pve-exporter.monitoring.svc.cluster.local:9221

grafana:
  adminPassword: "{{ grafana_admin_password }}"
  deploymentStrategy:
    type: Recreate
  persistence:
    enabled: true
    storageClassName: longhorn
    size: 1Gi
  dashboardProviders:
    dashboardproviders.yaml:
      apiVersion: 1
      providers:
        - name: default
          folder: Homelab
          type: file
          options:
            path: /var/lib/grafana/dashboards/default
  dashboards:
    default:
      longhorn:
        gnetId: 13032
        revision: 6
        datasource: Prometheus
      traefik:
        gnetId: 17346
        revision: 9
        datasource: Prometheus
      pve:
        gnetId: 10347
        revision: 5
        datasource: Prometheus
      k8s-nodes:
        gnetId: 1860
        revision: 37
        datasource: Prometheus
      loki-logs:
        gnetId: 13639
        revision: 2
        datasource: Loki
  additionalDataSources:
    - name: Loki
      type: loki
      url: http://loki-gateway.monitoring.svc.cluster.local
      access: proxy
      isDefault: false

kubeScheduler:
  enabled: false
kubeControllerManager:
  enabled: false
kubeProxy:
  enabled: false
kubeEtcd:
  enabled: false

kubeStateMetrics:
  enabled: true
