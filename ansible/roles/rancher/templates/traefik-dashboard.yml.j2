---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: traefik-dashboard
  namespace: traefik
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`{{ traefik_hostname }}`)
      kind: Rule
      middlewares:
        - name: lan-only          # defined in kubernetes/system/traefik/middlewares.yml
          namespace: traefik
      services:
        - name: api@internal
          kind: TraefikService
  tls: {}
