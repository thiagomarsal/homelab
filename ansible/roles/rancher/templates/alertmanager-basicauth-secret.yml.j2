---
# Managed by Ansible. Credentials come from vault vars in group_vars/all.yml.
# Do NOT apply this file manually or commit rendered values.
#
# alertmanager_basicauth_hash is a pre-computed bcrypt hash (from `htpasswd -nbB`),
# not a plaintext password — embedded verbatim so the Ansible control host never
# needs the passlib library at template-render time.
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-basicauth
  namespace: monitoring
type: Opaque
stringData:
  users: "{{ alertmanager_basicauth_user }}:{{ alertmanager_basicauth_hash }}"
